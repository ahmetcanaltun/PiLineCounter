# Camera Module - Environment Variables Template
# Copy to .env: cp .env.example .env

# Ana uygulamanın URL'i (Occupancy Backend backend)
API_BASE_URL=https://your-backend.example.com

# Backend'de cihaza atanan kimlik (admin paneli "Yeni Cihaz" oluşturunca verilir)
DEVICE_ID=device-01

# Backend'in cihaz için ürettiği plain token (yalnızca oluştururken bir kez gösterilir)
DEVICE_TOKEN=
