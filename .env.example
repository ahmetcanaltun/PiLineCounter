# Optional - fleet integration only.
# The counter runs fully standalone without this file. Copy it only if you want
# the device to report to a central backend:  cp .env.example .env

# Base URL of the backend that collects occupancy data
API_BASE_URL=https://your-backend.example.com

# Identifier assigned to this device by the backend
DEVICE_ID=device-01

# Plain token issued by the backend for this device (shown once, at creation)
DEVICE_TOKEN=
